# Public site configuration.
# Every value here is NEXT_PUBLIC, so it ships in the client bundle and is
# safe to expose. If any are unset, lib/config.ts falls back to sane defaults,
# so the site builds and runs without this file.
#
# Local dev: copy this to .env.local and edit.
# Production: set these under Vercel > Settings > Environment Variables.

NEXT_PUBLIC_SITE_URL=https://zkxhub.vercel.app
NEXT_PUBLIC_KEY_SYSTEM_URL=https://jnkie.com/get-key/zkxhub
NEXT_PUBLIC_DISCORD_URL=https://discord.com/invite/bxu2WMjNjN
NEXT_PUBLIC_SERVICE_STATUS=operational
